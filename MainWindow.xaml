<Window x:Class="WPF_DataBinding_DataSet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:local="clr-namespace:WPF_DataBinding_DataSet"
        Title="Student data" Height="249" Width="504">
  <DockPanel >
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="File">
        <MenuItem Header="Load" Click="miLoad_Click"/>
        <MenuItem Name="miMent" Header="Save" Click="miSave_Click"/>
        <Separator />
        <MenuItem Header="Exit" Click="miExit_Click"/>
      </MenuItem>
			<MenuItem Header="Show data">
				<MenuItem Header="Record by record" Click="miRecordByRecord_Click"/>
				<MenuItem Header="All data" Click="miAllData_Click" />
			</MenuItem>
		</Menu>
		<StackPanel>
			<local:ucRecordView x:Name="ucRecordView" Visibility="Collapsed"/>
			<DataGrid x:Name="dgGrid" Visibility="Collapsed" />
		</StackPanel>
  </DockPanel>
</Window>
